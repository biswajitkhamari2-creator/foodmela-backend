# ── Copy to .env (local) + Vercel → Settings → Environment Variables ──
# ⚠️ ROTATE the old token in Upstash dashboard — it was hardcoded in git history.
UPSTASH_URL=https://deciding-fish-161177.upstash.io
UPSTASH_TOKEN=paste-new-token-here
PORT=3000

# API session tokens (SECURITY 2026-09-18) — HMAC secret for phone-bound
# apiTokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in Vercel env. Without it the server falls back to
# PAYU_SALT (works, but set a dedicated secret).
API_TOKEN_SECRET=paste-random-64-hex-chars-here

# Cron protection (SECURITY 2026-09-18) — /api/orders/watch requires
# Authorization: Bearer <CRON_SECRET>. Set in Vercel env + Vercel Cron config.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=paste-random-48-hex-chars-here

# PayU (live) — NEVER commit real values. Set in Vercel → Settings → Environment Variables.
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=production
PAYU_SURL=https://foodmela.online/api/payu/callback
PAYU_FURL=https://foodmela.online/api/payu/callback

# Agora (in-app calls) — leave blank to disable calling, backend 501s cleanly
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY=
RECORDING_STORAGE_SECRET_KEY=
